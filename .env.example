# Copy to .env.local and fill in. Never commit real values.

# Supabase project (Dashboard -> Project Settings -> API / API Keys)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# The app's connection: role this_or_that_app through the transaction pooler (port 6543).
# Password: vault secret this_or_that_app_db_password.
DATABASE_URL=postgresql://this_or_that_app.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Shared with the pg_cron dispatcher: vault secret this_or_that_advance_secret.
ADVANCE_SECRET=

# Migrations only (npm run db:migrate): an admin connection on port 5432, not the pooler.
SUPABASE_DB_URL=
